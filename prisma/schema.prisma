generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
enum JobModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobCategory {
  IT
  FINANCE
  MARKETING
  LOGISTICS
  ADMINISTRATION
  ENGINEERING
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  MANDATE
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  HYBRID
  OFFICE
}

model User {
  id            String        @id @default(cuid())
  name          String?
  phone       String?
  description String? @db.Text
  cvUrl       String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole      @default(CANDIDATE)
  accounts      Account[]
  sessions      Session[]
  employerJobs  Job[]
  applications  Application[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  savedJobs SavedJob[]
  notifications Notification[]

}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id             Int             @id @default(autoincrement())
  title          String
  company        String
  location       String
  category       JobCategory     @default(OTHER)
  employmentType EmploymentType  @default(FULL_TIME)
  workMode       WorkMode        @default(OFFICE)
  description    String
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?         @db.VarChar(3)
  createdAt      DateTime        @default(now())
  employerId     String?
  employer       User?           @relation(fields: [employerId], references: [id], onDelete: SetNull)
  applications   Application[]
  savedBy        SavedJob[]
  isActive Boolean @default(true)
  moderationStatus JobModerationStatus @default(APPROVED)
  moderationReason String? @db.Text
  views Int @default(0)

  @@index([employerId])
}

model Application {
  id          Int      @id @default(autoincrement())
  candidateId String
  jobId       Int
  createdAt   DateTime @default(now())
  status      ApplicationStatus @default(PENDING)

  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([jobId])
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  userId    String
  jobId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
}
model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}